# Copy to .env in this folder. Real credentials belong only in .env.
HOST=127.0.0.1
PORT=8101
DOSSIER_PROVIDER=gemini
DOSSIER_ROUTE=gateway
GATEWAY_URL=http://127.0.0.1:4000
# These keys are used for DOSSIER_ROUTE=sdk. Gateway routing uses the gateway's own .env.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
