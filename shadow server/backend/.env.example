SHADOWAI_DB_HOST=127.0.0.1
SHADOWAI_DB_PORT=5432
SHADOWAI_DB_NAME=shadow_ai_discovery
SHADOWAI_DB_USER=postgres
SHADOWAI_DB_PASSWORD=
DOSSIER_PROVIDER=gemini
DOSSIER_ROUTE=gateway
GATEWAY_URL=http://127.0.0.1:4000
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
